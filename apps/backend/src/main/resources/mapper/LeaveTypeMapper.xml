<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.kintai.leave.mapper.LeaveTypeMapper">

    <resultMap id="leaveTypeMap" type="com.company.kintai.leave.entity.LeaveTypeEntity">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="daysPerYear" column="days_per_year"/>
        <result property="isPaid" column="is_paid"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="version" column="version"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <select id="selectAll" resultMap="leaveTypeMap">
        SELECT * FROM app.leave_type WHERE deleted_at IS NULL ORDER BY id
    </select>

    <select id="selectById" resultMap="leaveTypeMap">
        SELECT * FROM app.leave_type WHERE id = #{id} AND deleted_at IS NULL
    </select>

</mapper>