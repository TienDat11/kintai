<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.kintai.leave.mapper.LeaveRequestMapper">

    <resultMap id="leaveRequestMap" type="com.company.kintai.leave.entity.LeaveRequestEntity">
        <id property="id" column="id"/>
        <result property="employeeId" column="employee_id"/>
        <result property="leaveTypeId" column="leave_type_id"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate" column="end_date"/>
        <result property="days" column="days"/>
        <result property="reason" column="reason"/>
        <result property="status" column="status"/>
        <result property="approverId" column="approver_id"/>
        <result property="approvedAt" column="approved_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="version" column="version"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <select id="selectById" resultMap="leaveRequestMap">
        SELECT * FROM app.leave_request
        WHERE id = #{id} AND deleted_at IS NULL
    </select>

    <select id="selectByEmployeeId" resultMap="leaveRequestMap">
        SELECT * FROM app.leave_request
        WHERE employee_id = #{employeeId} AND deleted_at IS NULL
        ORDER BY id DESC
    </select>

    <select id="selectByStatus" resultMap="leaveRequestMap">
        SELECT * FROM app.leave_request
        WHERE status = #{status} AND deleted_at IS NULL
        ORDER BY id DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO app.leave_request
            (employee_id, leave_type_id, start_date, end_date, days, reason, status,
             created_by, updated_by)
        VALUES
            (#{employeeId}, #{leaveTypeId}, #{startDate}, #{endDate}, #{days}, #{reason}, 'PENDING',
             #{createdBy}, #{updatedBy})
    </insert>

    <update id="updateStatus">
        UPDATE app.leave_request
        SET status = #{status},
            approver_id = #{approverId},
            updated_at = now(),
            updated_by = #{updatedBy}
        WHERE id = #{id} AND deleted_at IS NULL
    </update>

</mapper>