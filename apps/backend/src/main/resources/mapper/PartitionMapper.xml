<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.kintai.common.scheduler.mapper.PartitionMapper">

    <select id="ensureFuturePartitions">
        SELECT app.ensure_future_partitions(#{pMonthsAhead})
    </select>

    <select id="detachOldPartitions" resultType="int">
        SELECT app.detach_old_partitions(#{pKeepMonths})
    </select>

</mapper>
